# Servidor
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=programa_estagio
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Microsoft Entra ID (Azure AD) — Preencher com dados do TI
AZURE_CLIENT_ID=SEU_CLIENT_ID_AQUI
AZURE_CLIENT_SECRET=SEU_CLIENT_SECRET_AQUI
AZURE_TENANT_ID=SEU_TENANT_ID_AQUI
AZURE_REDIRECT_URI=http://localhost:3000/auth/callback

# Sessão
SESSION_SECRET=trocar_por_string_segura_em_producao

# Admin emails (separados por vírgula)
ADMIN_EMAILS=eduarda.dreux@galapagoscapital.com,felipe.regis@galapagoscapital.com,natasha.guerra@galapagoscapital.com

# Anthropic (Claude) — opcional. Sem essa chave, o app funciona normalmente,
# só não gera o resumo automático do histórico a partir do currículo em PDF.
ANTHROPIC_API_KEY=
